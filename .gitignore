# Rust build artifacts
target/

# FastF1 download cache (regenerable, see apexsim/artifacts/validation/FASTF1_NOTES.md)
apexsim/artifacts/validation/fastf1_cache/

# Simulation run logs and replay recordings (regenerable via documented commands/seeds)
*.log
*.simlog

# Batch/tournament report output (regenerable: `apexsim tournament --out-dir out/...`)
apexsim/out/
apexsim/bench/

# Python bytecode caches from the tools/ interop and sprite scripts
__pycache__/
*.pyc

# Diagnostic renders from the one-time car-image audit; AUDIT.md keeps the findings
images_audit/*.png
images_audit/views/

# Local build-path override (a OneDrive workaround). It hardcodes one machine's
# home directory and breaks the build for anyone who clones it, so it stays out
# of the repo. Set CARGO_TARGET_DIR in your own environment instead.
apexsim/.cargo/config.toml

# ZCode's per-workflow session state — not part of the project
.zcode/

# Phase-12 dataset: regenerated by tools/gym_train.py, not shipped (22 MB)
artifacts/phase12/expert.npz
